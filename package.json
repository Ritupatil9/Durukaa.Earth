{
  "name": "darukaa-earth",
  "private": true,
  "version": "0.1.0",
  "description": "Monorepo root - manages Git hooks (Husky + lint-staged) shared across frontend and backend.",
  "scripts": {
    "prepare": "husky"
  },
  "devDependencies": {
    "husky": "^9.1.6",
    "lint-staged": "^15.2.10"
  },
  "lint-staged": {
    "frontend/**/*.{js,jsx}": [
      "bash -c 'cd frontend && npx eslint --fix'",
      "bash -c 'cd frontend && npx prettier --write'"
    ],
    "frontend/**/*.{css,md,json}": [
      "bash -c 'cd frontend && npx prettier --write'"
    ],
    "backend/**/*.py": [
      "bash -c 'cd backend && . .venv/bin/activate 2>/dev/null; ruff check --fix' ",
      "bash -c 'cd backend && . .venv/bin/activate 2>/dev/null; black' "
    ]
  }
}
